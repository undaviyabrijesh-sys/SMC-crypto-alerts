# Copy to .env and fill these values. Never commit the real .env file.
OPENAI_API_KEY=put_your_openai_api_key_here
OPENAI_MODEL=gpt-6.1-terra
OPENAI_REASONING_EFFORT=high
DISCORD_TRIGGER_WEBHOOK=put_your_discord_webhook_here

# Optional: authenticated Delta read-only account check (no order permissions needed)
DELTA_API_KEY=put_your_delta_api_key_here
DELTA_API_SECRET=put_your_delta_api_secret_here
DELTA_API_BASE_URL=https://api.india.delta.exchange
