# Copy to .env and fill these values. Never commit the real .env file.
DISCORD_TRIGGER_WEBHOOK=put_your_discord_webhook_here

# Optional: authenticated Delta read-only account check (no order permissions needed)
DELTA_API_KEY=put_your_delta_api_key_here
DELTA_API_SECRET=put_your_delta_api_secret_here
DELTA_API_BASE_URL=https://api.india.delta.exchange

 
# Runtime lane: quant (default, no AI calls) or dns (AI-authored map + local DNS watcher)
WORKER_MODE=quant

# Optional TradingAgents-inspired candidate debate, called only after a local DNS trigger.
# Requires OPENAI_API_KEY and WORKER_MODE=dns. Keep false to use map-only AI.
AI_TRADE_DEBATE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
DNS_MAP_REFRESH_HOURS=4
AI_TRADE_REVIEW_FAILURE_COOLDOWN_MINUTES=30
